--- c/src/shell-app.c
+++ i/src/shell-app.c
@@ -77,6 +77,7 @@ struct _ShellApp
                           * the way shell-window-tracker.c works).
                           */
   GIcon *fallback_icon;
+  MetaWindow *fallback_icon_window;
 
   ShellAppRunningState *running_state;
 
@@ -186,6 +187,47 @@ window_backed_app_get_window (ShellApp     *app)
     return NULL;
 }
 
+static GIcon *
+window_create_fallback_gicon (MetaWindow *window)
+{
+  cairo_surface_t *surface = NULL;
+  char *icon_name = NULL;
+  GIcon *icon;
+
+  g_object_get (window,
+                "icon", &surface,
+                "icon-name", &icon_name,
+                NULL);
+
+  if (surface)
+    icon = st_texture_cache_load_cairo_surface_to_gicon (surface);
+  else if (icon_name)
+    icon = g_themed_icon_new (icon_name);
+  else
+    icon = NULL;
+
+  g_free (icon_name);
+  return icon;
+}
+
+static void
+on_window_icon_changed (GObject    *object,
+                        GParamSpec *pspec,
+                        gpointer    user_data)
+{
+  MetaWindow *window = META_WINDOW (object);
+  ShellApp *app = user_data;
+  GIcon *icon;
+
+  icon = window_create_fallback_gicon (window);
+  if (!icon)
+    icon = g_themed_icon_new ("application-x-executable");
+
+  g_clear_object (&app->fallback_icon);
+  app->fallback_icon = icon;
+  g_object_notify_by_pspec (G_OBJECT (app), props[PROP_ICON]);
+}
+
 /**
  * shell_app_get_icon:
  *
@@ -196,11 +238,29 @@ window_backed_app_get_window (ShellApp     *app)
 GIcon *
 shell_app_get_icon (ShellApp *app)
 {
+  MetaWindow *window = NULL;
+
   g_return_val_if_fail (SHELL_IS_APP (app), NULL);
 
   if (app->info)
     return g_app_info_get_icon (G_APP_INFO (app->info));
 
+  if (app->fallback_icon)
+    return app->fallback_icon;
+
+  if (app->running_state)
+    window = window_backed_app_get_window (app);
+
+  if (window)
+    {
+      app->fallback_icon_window = window;
+      app->fallback_icon = window_create_fallback_gicon (window);
+      g_signal_connect (G_OBJECT (window), "notify::icon",
+                        G_CALLBACK (on_window_icon_changed), app);
+      g_signal_connect (G_OBJECT (window), "notify::icon-name",
+                        G_CALLBACK (on_window_icon_changed), app);
+    }
+
   if (!app->fallback_icon)
     app->fallback_icon = g_themed_icon_new ("application-x-executable");
 
@@ -1124,6 +1184,12 @@ _shell_app_add_window (ShellApp        *app,
   g_signal_connect_object (window, "notify::user-time", G_CALLBACK(shell_app_on_user_time_changed), app, 0);
   g_signal_connect_object (window, "notify::skip-taskbar", G_CALLBACK(shell_app_on_skip_taskbar_changed), app, 0);
 
+  if (!app->info && app->fallback_icon && !app->fallback_icon_window)
+    {
+      g_clear_object (&app->fallback_icon);
+      g_object_notify_by_pspec (G_OBJECT (app), props[PROP_ICON]);
+    }
+
   shell_app_update_app_actions (app, window);
   shell_app_ensure_busy_watch (app);
 
@@ -1161,6 +1227,16 @@ _shell_app_remove_window (ShellApp   *app,
   g_signal_handlers_disconnect_by_func (window, G_CALLBACK(shell_app_on_user_time_changed), app);
   g_signal_handlers_disconnect_by_func (window, G_CALLBACK(shell_app_on_skip_taskbar_changed), app);
 
+  if (window == app->fallback_icon_window)
+    {
+      g_signal_handlers_disconnect_by_func (window,
+                                            G_CALLBACK(on_window_icon_changed),
+                                            app);
+      app->fallback_icon_window = NULL;
+      g_clear_object (&app->fallback_icon);
+      g_object_notify_by_pspec (G_OBJECT (app), props[PROP_ICON]);
+    }
+
   g_object_unref (window);
 
   g_signal_emit (app, shell_app_signals[WINDOWS_CHANGED], 0);
diff --git c/src/st/st-texture-cache.c i/src/st/st-texture-cache.c
index 133d948..76bb4b4 100644
--- c/src/st/st-texture-cache.c
+++ i/src/st/st-texture-cache.c
@@ -558,6 +558,81 @@ pixbuf_to_st_content_image (GdkPixbuf    *pixbuf,
   return image;
 }
 
+GIcon *
+st_texture_cache_load_cairo_surface_to_gicon (cairo_surface_t *surface)
+{
+  ClutterActor *actor;
+  ClutterContext *context;
+  ClutterBackend *backend;
+  CoglContext *cogl_context;
+  GdkPixbuf *pixbuf;
+  ClutterContent *image;
+  g_autoptr (GError) error = NULL;
+  const guint32 *src;
+  guint8 *dst;
+  cairo_format_t format;
+  int width, height, src_stride, dst_stride;
+  int x, y;
+
+  width = cairo_image_surface_get_width (surface);
+  height = cairo_image_surface_get_height (surface);
+  format = cairo_image_surface_get_format (surface);
+  src_stride = cairo_image_surface_get_stride (surface);
+  src = (const guint32 *) cairo_image_surface_get_data (surface);
+
+  pixbuf = gdk_pixbuf_new (GDK_COLORSPACE_RGB, TRUE, 8, width, height);
+  if (!pixbuf)
+    return NULL;
+
+  dst = gdk_pixbuf_get_pixels (pixbuf);
+  dst_stride = gdk_pixbuf_get_rowstride (pixbuf);
+
+  for (y = 0; y < height; y++)
+    {
+      const guint32 *src_row = (const guint32 *) ((const guint8 *) src + y * src_stride);
+      guint8 *dst_row = dst + y * dst_stride;
+
+      for (x = 0; x < width; x++)
+        {
+          guint32 pixel = src_row[x];
+          guint8 a = format == CAIRO_FORMAT_RGB24 ? 255 : pixel >> 24;
+          guint8 r = (pixel >> 16) & 0xff;
+          guint8 g = (pixel >> 8) & 0xff;
+          guint8 b = pixel & 0xff;
+
+          if (a != 0 && a != 255)
+            {
+              r = (r * 255) / a;
+              g = (g * 255) / a;
+              b = (b * 255) / a;
+            }
+
+          dst_row[x * 4 + 0] = r;
+          dst_row[x * 4 + 1] = g;
+          dst_row[x * 4 + 2] = b;
+          dst_row[x * 4 + 3] = a;
+        }
+    }
+
+  actor = create_invisible_actor ();
+  context = clutter_actor_get_context (actor);
+  backend = clutter_context_get_backend (context);
+  cogl_context = clutter_backend_get_cogl_context (backend);
+
+  image = pixbuf_to_st_content_image (pixbuf, cogl_context,
+                                      -1, -1, 1, 1.0, &error);
+  g_object_unref (pixbuf);
+  g_object_unref (actor);
+
+  if (!image)
+    {
+      g_warning ("Failed to load icon surface: %s", error->message);
+      return NULL;
+    }
+
+  return G_ICON (image);
+}
+
 static void
 util_cairo_surface_paint_pixbuf (cairo_surface_t *surface,
                                  const GdkPixbuf *pixbuf)
