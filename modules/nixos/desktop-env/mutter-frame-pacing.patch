+} NextFrameReadySource;
+
+static void
+mark_next_frame_kms_ready (CoglOnscreen *onscreen)
+{
+  MetaOnscreenNative *onscreen_native = META_ONSCREEN_NATIVE (onscreen);
+  CoglFrameInfo *frame_info;
