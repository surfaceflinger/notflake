+void
+meta_window_set_icon (MetaWindow      *window,
+                      cairo_surface_t *icon,
+                      cairo_surface_t *mini_icon)
+{
+  cairo_surface_t *new_icon = NULL;
+  cairo_surface_t *new_mini_icon = NULL;
+  gboolean changed;
+
+  if (icon)
+    new_icon = cairo_surface_reference (icon);
+  if (mini_icon)
+    new_mini_icon = cairo_surface_reference (mini_icon);
+
+  changed = window->icon != new_icon || window->mini_icon != new_mini_icon;
+
+  g_clear_pointer (&window->icon, cairo_surface_destroy);
+  g_clear_pointer (&window->mini_icon, cairo_surface_destroy);
+  window->icon = new_icon;
+  window->mini_icon = new_mini_icon;
+
+  if (!changed)
+    return;
+
+  g_object_freeze_notify (G_OBJECT (window));
+  g_object_notify (G_OBJECT (window), "icon");
+  g_object_notify (G_OBJECT (window), "mini-icon");
+  g_object_thaw_notify (G_OBJECT (window));
+}
