index 0000000..29a1b24
--- /dev/null
+++ i/src/wayland/meta-wayland-xdg-toplevel-icon.c
@@ -0,0 +1,409 @@
+/* -*- mode: C; c-file-style: "gnu"; indent-tabs-mode: nil; -*- */
+
